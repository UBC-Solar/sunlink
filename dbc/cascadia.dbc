CM_ BU_ HVC "High voltage controller (precharge, pack shunt current, HV faults)";
CM_ BU_ MST "Cascadia BMS master board";
CM_ BU_ DIST "Low voltage power distribution board";
CM_ BU_ TEL "Telemetry board (IMU, GPS)";
CM_ BU_ MDI "Motor drive interface board (DAC throttle/regen to the Mitsuba controller)";
CM_ BU_ STR "Steering wheel board";
CM_ BU_ DRD "Driver display / dashboard board";
CM_ BU_ MPPT "Maximum power point trackers A-D";
CM_ BU_ MC "Mitsuba motor controller";
CM_ BU_ MEMORATOR "Kvaser Memorator CAN logger";
CM_ BU_ OBC "On-board charger";
CM_ BO_ 512 "MST heartbeat and pack status. Bit order per mst/app/can_messages.c (after MST PR 111).";
CM_ SG_ 512 NumCommFails "Total isoSPI comm failures, saturates at 65535";
CM_ BO_ 513 "Pack voltage summary. Min/Max module indices are 1-based (Mod0 here is index 1).";
CM_ BO_ 514 "Temperature summary. Min/Max indices are 1-based. Firmware bug: AvgTemp high byte is always 0, so negative temperatures read as 256 + T.";
CM_ BO_ 515 "Bit n set = module n balancing (0-based, same numbering as ModN signals)";
CM_ BO_ 544 "Firmware bug: high byte of each temperature is always 0, so negative temperatures read as 256 + T.";
CM_ BO_ 545 "Firmware bug: high byte of each temperature is always 0, so negative temperatures read as 256 + T.";

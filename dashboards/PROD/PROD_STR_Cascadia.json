  "panels": [
    {
      "type": "stat",
      "title": "STR: Fault banner",
      "description": "Red: a fault bit is set now (names listed). Orange: something is wrong that is not a fault bit: STR link lost / rebooted. Blank when everything is normal.",
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "import \"array\"\nimport \"strings\"\nst = from(bucket: \"CAN_prod\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"STR\")\n  |> filter(fn: (r) => r[\"class\"] == \"STRFlags\")\n  |> filter(fn: (r) => r[\"_field\"] == \"STRMCUUnderVoltage\" or r[\"_field\"] == \"STRMCUOverTemp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> toInt()\n  |> duplicate(column: \"_value\", as: \"now\")\n  |> cumulativeSum(columns: [\"_value\"])\n  |> map(fn: (r) => ({_time: r._time, _field: r._field, _value: if r.now > 0 then 2 else if r._value > 0 then 1 else 0}))\n  |> last()\n  |> group()\nact = st |> filter(fn: (r) => r._value == 2) |> findColumn(fn: (key) => true, column: \"_field\")\nwl = from(bucket: \"CAN_prod\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"STR\" and r[\"class\"] == \"STRTimeSinceBootup\")\n  |> last()\n  |> map(fn: (r) => ({r with _value:\n      if float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0 > 3.0 then \"STR link lost\"\n      else if float(v: r._value) < 60.0 then \"STR rebooted \" + string(v: int(v: r._value)) + \" s ago\"\n      else \"\"}))\n  |> keep(columns: [\"_value\"])\nwarn = wl |> group() |> filter(fn: (r) => r._value != \"\") |> findColumn(fn: (key) => true, column: \"_value\")\nf = if length(arr: act) > 0 then \"ACTIVE FAULT: \" + strings.joinStr(arr: act, v: \", \") else \"\"\nw = if length(arr: warn) > 0 then \"WARNING: \" + strings.joinStr(arr: warn, v: \", \") else \"\"\nmsg = if f != \"\" and w != \"\" then f + \"   |   \" + w else f + w\narray.from(rows: [{_value: msg}]) |> yield(name: \"banner\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^ACTIVE FAULT.*",
                "result": {
                  "color": "#ff1a1a",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^WARNING.*",
                "result": {
                  "color": "#ff9830",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "empty",
                "result": {
                  "text": " ",
                  "color": "transparent",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "text": {
          "valueSize": 28
        }
      },
      "pluginVersion": "9.5.2",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1

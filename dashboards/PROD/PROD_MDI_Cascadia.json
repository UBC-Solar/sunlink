    {
      "type": "state-timeline",
      "title": "MDI: Faults",
      "description": "MDIDiagnostics bits. MDIVoltageOverThreshold is defined but not set by current MDI firmware, so it always reads OK. Per row: OK, FAULT (red) while set, CLEARED (yellow) once it has faulted in the time range shown. Zoom the time range past an old fault to clear the yellow.",
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "from(bucket: \"CAN_prod\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"MDI\")\n  |> filter(fn: (r) => r[\"class\"] == \"MDIDiagnostics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"MDIWatchdogReset\" or r[\"_field\"] == \"MDIVoltageOverThreshold\" or r[\"_field\"] == \"MDIMotorOverTemp\" or r[\"_field\"] == \"MDIRTDFault\" or r[\"_field\"] == \"MDIRTDCommError\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> toInt()\n  |> duplicate(column: \"_value\", as: \"now\")\n  |> cumulativeSum(columns: [\"_value\"])\n  |> map(fn: (r) => ({_time: r._time, _field: r._field, _value: if r.now > 0 then 2 else if r._value > 0 then 1 else 0}))\n  |> yield(name: \"fault_state\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "#8e8e8e",
                  "index": 0
                },
                "1": {
                  "text": "CLEARED",
                  "color": "#f2cc0c",
                  "index": 1
                },
                "2": {
                  "text": "FAULT",
                  "color": "#ff1a1a",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -1000000000000.0,
                "to": 1000000000000.0,
                "result": {
                  "text": "UNKNOWN",
                  "color": "#ff9830",
                  "index": 3
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },

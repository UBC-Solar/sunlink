    {
      "type": "stat",
      "title": "DRD: Fault status",
      "description": "ACTIVE FAULT (red): a bit on the fault strip is set in the latest frame. FAULT IN WINDOW (yellow): a bit was set somewhere in the time range shown but none is set now. NO FAULTS: nothing set in the range.",
      "datasource": {
        "type": "influxdb",
        "uid": "P951FEA4DE68E13C5"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "P951FEA4DE68E13C5"
          },
          "query": "data = from(bucket: \"CAN_prod\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"DRD\")\n  |> filter(fn: (r) => r[\"class\"] == \"DRDDiagnostics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"ADCOutOfRange\" or r[\"_field\"] == \"ADCMismatch\" or r[\"_field\"] == \"DRDWatchdogReset\" or r[\"_field\"] == \"MotorCommFault\" or r[\"_field\"] == \"DRDMCUOverTemp\" or r[\"_field\"] == \"DRDMCUUnderVoltage\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> toInt()\nactive = data |> last() |> map(fn: (r) => ({r with _value: r._value * 2}))\nseen = data |> max()\nunion(tables: [active, seen])\n  |> group()\n  |> max()\n  |> map(fn: (r) => ({_time: r._time, _field: \"Fault status\", _value: r._value}))\n  |> yield(name: \"status\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO FAULTS",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "FAULT IN WINDOW",
                  "color": "#f2cc0c",
                  "index": 1
                },
                "2": {
                  "text": "ACTIVE FAULT",
                  "color": "#ff1a1a",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
